# Optional browser API override. The default is /api/send-email.
# Local Vite development and preview forward that path to the existing live site.
# Never put API keys or email-provider secrets in VITE_ variables.
VITE_CONTACT_API_URL=

# Username "kunal" signs in to this Firebase Authentication email account.
# Create the account in Firebase Console. Never put its password here.
VITE_FIREBASE_ADMIN_EMAIL=dev.kunaljadhav@gmail.com

# Set true AFTER configuring Authentication, Firestore rules and the article index.
# Restart Vite locally / rebuild your Vercel deployment after changing this.
VITE_FIREBASE_ARTICLES_ENABLED=true
